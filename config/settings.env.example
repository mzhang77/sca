# settings.env - 本工具的设置（bash 语法，下次运行即生效）
# 可选：没有 config/settings.env 时，所有设置都用脚本里的默认值（和本文件的值相同，只有 EXTRA_PATH 默认为空）。
# 需要改设置时：cp config/settings.env.example config/settings.env，再改 settings.env（它不进 git）。

# 项目所在的挂载点（可选）。设了之后，没挂载时所有脚本直接退出（exit 2）。留空 = 不检查。
# 例：项目放在外置盘上 -> REQUIRED_MOUNT="/Volumes/MyDisk"
REQUIRED_MOUNT=""

# 本项目用的 Go 缓存（go / govulncheck 下载的模块、编译缓存、自动下载的 Go 工具链）。
# 只在 SCA 运行时生效（以环境变量传给 go），不改 `go env -w` 的全局设置；bin/cleanup.sh 清理的也是这两个目录。
# 不写 = 放在项目里的 caches/go-build、caches/go-mod（不进 git）；设成 "" = 不覆盖，用 Go 自己的全局设置。
#GO_BUILD_CACHE="$SCA_ROOT/caches/go-build"
#GO_MOD_CACHE="$SCA_ROOT/caches/go-mod"

# 额外加入 PATH 的目录（冒号分隔）。工具装在非标准位置时在这里补充。
# 例：用 gvm 管理 Go 时 -> $HOME/.gvm/gos/go1.xx.x/bin （用 `gvm list` 查看实际版本）
# `go install` 装的工具在 $(go env GOPATH)/bin，默认 $HOME/go/bin
EXTRA_PATH="$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin"

OSV_SCANNER="osv-scanner"        # 主扫描器（需要 v2.x）
GOVULNCHECK="govulncheck"        # Go 可达性分析（可选）
# 0 = 不跑 govulncheck（缺省）：客户扫的是镜像，扫描器只按版本匹配、不看可达性，所以可达性不影响“客户会报什么”；
#     关掉后 Go 漏洞的可达性列为 unknown，也省掉最慢的一步。1 = 打开（或单次运行加 --govulncheck）
GOVULNCHECK_ENABLED=0
GO_MOD_MAXDEPTH=4                # 在分支内查找 go.mod 的最大目录深度（每个 module 单独跑 govulncheck）

# 结果里忽略的路径（正则，匹配清单文件相对仓库根的路径）。
# 原则：扫分支是为了在镜像 build 之前看到“这个分支 build 出来的镜像大概会被扫出什么”，
# 所以不会编进交付二进制的清单都要排除：测试模块（tests/ integration_tests/）、示例（examples/）、测试数据、第三方目录。
# 注意不要笼统排除 tools/：pd 的 pd-ctl 等就在 tools/ 模块里，是随镜像交付的。
EXCLUDE_PATH_REGEX='(^|/)(node_modules|testdata|third_party|tests|integration_tests|examples|\.git)(/|$)'
INCLUDE_DEV_DEPS=0               # 0 = 忽略仅属于 dev 依赖组的包（若 OSV 输出带依赖组信息）

KEV_URL="https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json"

RETENTION=10                     # 每个分支保留最近多少次扫描结果（不分成败），更早的在每次运行结束时删除
PREVENT_SLEEP=1                  # 1 = 运行期间用 caffeinate 防止 Mac 睡眠；0 = 关闭

# 超时（秒）。超时按失败处理并写 [ALERT]
CLONE_TIMEOUT=3600               # 首次 fetch / 创建 worktree（TiDB、TiKV 较大）
FETCH_TIMEOUT=900
OSV_TIMEOUT=1800
GOVULN_TIMEOUT=2700              # 每个 go module
KEV_TIMEOUT=120

# ---- 镜像报告（bin/run.sh 第 2 步：用 Trivy 扫交付镜像）----
TRIVY="trivy"                    # brew install trivy
TRIVY_TIMEOUT=1800               # 每个镜像的扫描超时（秒，含首次下载漏洞库）
IMAGE_PLATFORM="linux/amd64"     # 客户实际运行的平台；Mac 是 arm64，必须指定，否则会拉 arm 版本
RECENT_DAYS=45                   # 报告里“近 N 天新公布”的 N
GO_OFFICIAL_DAYS=90              # 两份汇总最前面“Go 官方近期修复”看最近多少天（镜像报告和分支报告共用）
TRIVY_EXTRA_ARGS=""              # 额外传给 trivy image 的参数
USE_DOCKER_CREDS=0               # 0 = 匿名拉公开镜像（不读 ~/.docker 的凭据）；1 = 用你的 Docker 登录
BUILD_TIMEOUT=2700               # 源码构建（config/builds.conf）：每个包 go build 的超时（秒，首次要下载模块和 Go 工具链）
BUILD_GOTOOLCHAIN=""             # 源码构建用的 Go：空 = 按分支 go.mod 的 toolchain（没有则 go 指令）；也可写 local / auto / go1.27.3
BUILD_KEEP_BINARIES=0            # 1 = 扫完保留编出的二进制（state/build/<名称>/），排查用
