# bin/cve_check.py 的配置。一般每个客户一份，和客户的 CVE 清单放在同一个目录，命名为 cve_check.conf（脚本会自动读取）；
# 也可以放在 config/cve_check.conf 作为默认，或用 --config 指定。命令行给了 --repo/--branch/--base 时忽略这里的 target。
#
# target  名称或仓库URL  客户分支  [master分支]
#   名称 = config/branches.conf 里的名称（用它的仓库 URL）；也可以直接写仓库 URL。
#   写了 master 分支：两个分支对比。没写：客户分支和 master 是同一个分支（如 tidb-operator），两边都用它。
#   所有行都没写 master 分支时，只报告客户分支是否解决。
target  tidb            release-8.5-customer   master
target  pd              release-8.5-customer   master
target  ng-monitoring   release-8.5-customer   main
target  tidb-operator   release-1.6
#
# exclude：已确认不适用、不再列出的 CVE，后面写原因（报告里单独列出）。
# exclude  CVE-2022-3023  TiDB 自身模块的伪版本被当成旧版 TiDB，误报
